{
  "description": "Require browser revalidation of Abby unversioned PWA scripts",
  "expression": "(http.host eq \"abby.bos.lol\" and http.request.uri.path in {\"/sw.js\" \"/push-sw.js\" \"/registerSW.js\"})",
  "action": "rewrite",
  "action_parameters": {
    "headers": {
      "cache-control": {
        "operation": "set",
        "value": "no-cache, max-age=0, must-revalidate"
      },
      "expires": {
        "operation": "remove"
      }
    }
  },
  "enabled": true
}
